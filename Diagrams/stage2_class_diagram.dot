"CareerFacade" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#bfdbfe"><B>CareerFacade</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Facade&gt;&gt;<BR ALIGN="LEFT"/>previewResume(Path): Resume<BR ALIGN="LEFT"/>importResume(Resume): Resume<BR ALIGN="LEFT"/>extractSkills(String): List&lt;SkillProposal&gt;<BR ALIGN="LEFT"/>approveSkills(List, Set): CandidateProfile<BR ALIGN="LEFT"/>analyzeJob(String): JobAnalysis<BR ALIGN="LEFT"/>approveJobAnalysis(JobAnalysis, Set): Job<BR ALIGN="LEFT"/>identifyGaps(String): Map; matchJobs(String): Map<BR ALIGN="LEFT"/>trackApplication(); updateApplicationStatus()<BR ALIGN="LEFT"/>listDeadlines(); checkDeadlines()</TD></TR></TABLE>>];
"CareerAgent" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#ddd6fe"><B>CareerAgent</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;feature-specific agent tasks&gt;&gt;<BR ALIGN="LEFT"/>extractSkills(resumeId): List&lt;SkillProposal&gt;<BR ALIGN="LEFT"/>analyzeJob(jobId): JobAnalysis<BR ALIGN="LEFT"/>grounded(source, label, evidence): boolean</TD></TR></TABLE>>];
