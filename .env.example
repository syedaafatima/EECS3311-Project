# Local configuration template. Never put real keys in this tracked file.
# Groq offers a quota-limited Free plan: https://console.groq.com/keys
LLM_PROVIDER=groq
GROQ_API_KEY=YOUR_LOCAL_API_KEY_HERE
GROQ_MODEL=openai/gpt-oss-20b

# Optional OpenAI provider: set LLM_PROVIDER=openai explicitly.
# OpenAI API billing is separate from a ChatGPT subscription.
OPENAI_API_KEY=YOUR_LOCAL_API_KEY_HERE
OPENAI_MODEL=gpt-4.1-mini
