digraph Classes {
 graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.8, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Stage 1 planned design (refined) \u2014 see Stage 2 diagram for implemented classes"];
