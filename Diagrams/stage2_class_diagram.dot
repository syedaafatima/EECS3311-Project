digraph Classes {
 graph [rankdir=TB, bgcolor="white", pad=0.3, nodesep=0.4, ranksep=0.8, fontname="DejaVu Sans", fontsize=20, labelloc=t, label="Stage 2 implemented architecture \u2014 November 7, 2026 (JSON/fingerprint helpers omitted)"];
 node [shape=plain, fontname="DejaVu Sans", fontsize=10];
 edge [fontname="DejaVu Sans", fontsize=9, color="#475569"];
"JobSearchGUI" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>JobSearchGUI</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;MVC view; Observer&gt;&gt;<BR ALIGN="LEFT"/>start(); close(); onDeadline(DeadlineReminder)<BR ALIGN="LEFT"/>SwingWorker dispatch + editable review dialogs</TD></TR></TABLE>>];
"JobSearchCLI" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>JobSearchCLI</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;MVC view; Observer&gt;&gt;<BR ALIGN="LEFT"/>run(); onDeadline(DeadlineReminder)<BR ALIGN="LEFT"/>prompt input + explicit review/consent</TD></TR></TABLE>>];
"AgentController" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>AgentController</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;MVC controller&gt;&gt;<BR ALIGN="LEFT"/>submitRequest(String, Map): String<BR ALIGN="LEFT"/>pendingResume; pendingSkills; pendingAnalysis; pendingDocument<BR ALIGN="LEFT"/>list/get records; subscribe/unsubscribeDeadlines</TD></TR></TABLE>>];
"CareerFacade" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#bfdbfe"><B>CareerFacade</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Facade&gt;&gt;<BR ALIGN="LEFT"/>profile/resume/job/application workflows<BR ALIGN="LEFT"/>explainGaps(); explainMatches(); compareJobs()<BR ALIGN="LEFT"/>suggestResume(); draftLetter(); saveDocument()<BR ALIGN="LEFT"/>interview questions/session/feedback workflows<BR ALIGN="LEFT"/>saveCompanyNotes(); summarizeCompanyNotes()<BR ALIGN="LEFT"/>generateCareerPlan(); aiStatus(); verifyAI()</TD></TR></TABLE>>];
"CareerAgent" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#ddd6fe"><B>CareerAgent</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;feature-specific agent tasks&gt;&gt;<BR ALIGN="LEFT"/>extractSkills(); analyzeJob()<BR ALIGN="LEFT"/>explainGaps(); explainMatches(); summarizeComparison()<BR ALIGN="LEFT"/>suggestResume(); draftLetter()<BR ALIGN="LEFT"/>generateQuestions(); evaluateAnswers()<BR ALIGN="LEFT"/>summarizeNotes(); generateCareerPlan()<BR ALIGN="LEFT"/>evidence/schema/count/budget validation</TD></TR></TABLE>>];
"ToolManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>ToolManager</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;retrieval tools; Strategy context&gt;&gt;<BR ALIGN="LEFT"/>readProfile(); readResume(); readJob(); readNotes()<BR ALIGN="LEFT"/>compareSkills(); calculateMatch(); setMatchingStrategy()<BR ALIGN="LEFT"/>candidateEvidence(); writingFingerprint(); planEvidence()</TD></TR></TABLE>>];
"InterviewService" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>InterviewService</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;interview subsystem&gt;&gt;<BR ALIGN="LEFT"/>generateQuestions(); questions(); start()<BR ALIGN="LEFT"/>session(); answer(); transition(); feedback()<BR ALIGN="LEFT"/>save complete validated session records</TD></TR></TABLE>>];
"Repository" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>Repository</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;JSON persistence&gt;&gt;<BR ALIGN="LEFT"/>save/profile/resume/job/application records<BR ALIGN="LEFT"/>loadProfile(); find/list records; records(): LocalRecords<BR ALIGN="LEFT"/>atomic replacement writes</TD></TR></TABLE>>];
"LocalRecords" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>LocalRecords</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;atomic JSON record storage&gt;&gt;<BR ALIGN="LEFT"/>put(collection, id, record)<BR ALIGN="LEFT"/>get(collection, id); list(collection)<BR ALIGN="LEFT"/>documents / question-sets / interviews / company-notes</TD></TR></TABLE>>];
"LLMClient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#fde68a"><B>LLMClient</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Adapter target interface&gt;&gt;<BR ALIGN="LEFT"/>complete(instructions: String, context: String): String<BR ALIGN="LEFT"/>configurationStatus(): String</TD></TR></TABLE>>];
"ConfiguredLLMClient" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>ConfiguredLLMClient</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;explicit provider selection&gt;&gt;<BR ALIGN="LEFT"/>complete(String, String): String<BR ALIGN="LEFT"/>configurationStatus(): String<BR ALIGN="LEFT"/>local LLM_PROVIDER; no automatic fallback</TD></TR></TABLE>>];
"GroqAdapter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>GroqAdapter</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Adapter; free-plan API option&gt;&gt;<BR ALIGN="LEFT"/>complete(String, String): String<BR ALIGN="LEFT"/>configurationStatus(): String<BR ALIGN="LEFT"/>GROQ_API_KEY / GROQ_MODEL</TD></TR></TABLE>>];
"ChatCompletionAdapter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>ChatCompletionAdapter</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;shared HTTP translation&gt;&gt;<BR ALIGN="LEFT"/>complete(String, String): String<BR ALIGN="LEFT"/>configurationStatus(): String<BR ALIGN="LEFT"/>provider-specific key/model settings; JSON and error validation</TD></TR></TABLE>>];
"OpenAIAdapter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#fde68a"><B>OpenAIAdapter</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Adapter&gt;&gt;<BR ALIGN="LEFT"/>complete(String, String): String<BR ALIGN="LEFT"/>configurationStatus(): String<BR ALIGN="LEFT"/>local .env + HTTP request/response/error redaction</TD></TR></TABLE>>];
"ResumeParser" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#fde68a"><B>ResumeParser</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Adapter target interface&gt;&gt;<BR ALIGN="LEFT"/>extractText(file: Path): String</TD></TR></TABLE>>];
"DocumentParserAdapter" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#fde68a"><B>DocumentParserAdapter</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Adapter&gt;&gt;<BR ALIGN="LEFT"/>extractText(file: Path): String<BR ALIGN="LEFT"/>PDFBox / Apache POI</TD></TR></TABLE>>];
"MatchingStrategy" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>MatchingStrategy</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Strategy interface&gt;&gt;<BR ALIGN="LEFT"/>calculateMatch(CandidateProfile, Job): double<BR ALIGN="LEFT"/>getName(): String</TD></TR></TABLE>>];
"WeightedMatching" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>WeightedMatching</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Strategy&gt;&gt;<BR ALIGN="LEFT"/>calculateMatch(CandidateProfile, Job): double<BR ALIGN="LEFT"/>70% required / 30% preferred when both exist</TD></TR></TABLE>>];
"RequiredSkillMatching" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>RequiredSkillMatching</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Strategy&gt;&gt;<BR ALIGN="LEFT"/>calculateMatch(CandidateProfile, Job): double</TD></TR></TABLE>>];
"DeadlineManager" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#a7f3d0"><B>DeadlineManager</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Observer subject&gt;&gt;<BR ALIGN="LEFT"/>subscribe(DeadlineObserver): void<BR ALIGN="LEFT"/>unsubscribe(DeadlineObserver): void<BR ALIGN="LEFT"/>listDeadlines(): List&lt;DeadlineReminder&gt;<BR ALIGN="LEFT"/>checkDeadlines(): List&lt;DeadlineReminder&gt;<BR ALIGN="LEFT"/>Clock (Toronto default); daily deduplication</TD></TR></TABLE>>];
"DeadlineObserver" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#a7f3d0"><B>DeadlineObserver</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;Observer interface&gt;&gt;<BR ALIGN="LEFT"/>onDeadline(reminder: DeadlineReminder): void</TD></TR></TABLE>>];
"DeadlineReminder" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>DeadlineReminder</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable value&gt;&gt;<BR ALIGN="LEFT"/>jobId; title; company; deadline<BR ALIGN="LEFT"/>state; daysRemaining; timezone</TD></TR></TABLE>>];
"CandidateProfile" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>CandidateProfile</B></TD></TR><TR><TD ALIGN="LEFT">name; educationLevel; experience<BR ALIGN="LEFT"/>skills; interests; locationPreference<BR ALIGN="LEFT"/>updateProfile(...); updateSkills(Set)</TD></TR></TABLE>>];
"Resume" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>Resume</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable imported version&gt;&gt;<BR ALIGN="LEFT"/>id; originalPath; text; checksum<BR ALIGN="LEFT"/>hasText(): boolean</TD></TR></TABLE>>];
"Job" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>Job</B></TD></TR><TR><TD ALIGN="LEFT">id; title; company; description; salary; location; deadline<BR ALIGN="LEFT"/>requiredSkills; preferredSkills; analysisDetails<BR ALIGN="LEFT"/>updateDetails(); updateAnalysis(); updateReviewedAnalysis()</TD></TR></TABLE>>];
"Application" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>Application</B></TD></TR><TR><TD ALIGN="LEFT">id; jobId; submissionDate; status; statusHistory<BR ALIGN="LEFT"/>updateStatus(Status); restoreHistory(List)</TD></TR></TABLE>>];
"SkillProposal" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>SkillProposal</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable review proposal&gt;&gt;<BR ALIGN="LEFT"/>skill; evidence</TD></TR></TABLE>>];
"JobAnalysis" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>JobAnalysis</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable source snapshot&gt;&gt;<BR ALIGN="LEFT"/>jobId; sourceDescription; requirements</TD></TR></TABLE>>];
"Requirement" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>Requirement</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable categorized evidence&gt;&gt;<BR ALIGN="LEFT"/>kind; text; evidence</TD></TR></TABLE>>];
"Assessment" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>Assessment</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable result&gt;&gt;<BR ALIGN="LEFT"/>feature; deterministic facts; optional AI explanation</TD></TR></TABLE>>];
"CareerDocument" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>CareerDocument</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable reviewed writing&gt;&gt;<BR ALIGN="LEFT"/>id; type; jobId; sourceId; content; evidence<BR ALIGN="LEFT"/>sourceFingerprint; approved; createdAt<BR ALIGN="LEFT"/>draft(); approve(editedContent); toRecord()/fromRecord()</TD></TR></TABLE>>];
"QuestionSet" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>QuestionSet</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable original context&gt;&gt;<BR ALIGN="LEFT"/>id; jobId; jobContext; questions<BR ALIGN="LEFT"/>toRecord()/fromRecord()</TD></TR></TABLE>>];
"QuestionSet.Question" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>QuestionSet.Question</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable question/rubric&gt;&gt;<BR ALIGN="LEFT"/>kind; text; rubric; evidence</TD></TR></TABLE>>];
"InterviewSession" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>InterviewSession</B></TD></TR><TR><TD ALIGN="LEFT">id; questionSet; answers; skipped; feedback; status<BR ALIGN="LEFT"/>nextQuestion(); answer(); pause(); resume(); finish()<BR ALIGN="LEFT"/>attachFeedback(); toRecord()/fromRecord()</TD></TR></TABLE>>];
"AnswerFeedback" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>AnswerFeedback</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;immutable evaluation&gt;&gt;<BR ALIGN="LEFT"/>score; strengths; weaknesses; improvements<BR ALIGN="LEFT"/>answerEvidence; toRecord()/fromRecord()</TD></TR></TABLE>>];
"CompanyNotes" [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="8"><TR><TD BGCOLOR="#f1f5f9"><B>CompanyNotes</B></TD></TR><TR><TD ALIGN="LEFT">&lt;&lt;user research&gt;&gt;<BR ALIGN="LEFT"/>id; company; text; sources<BR ALIGN="LEFT"/>idFor(); fingerprint(); toRecord()/fromRecord()</TD></TR></TABLE>>];
